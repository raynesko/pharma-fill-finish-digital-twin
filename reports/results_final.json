  "hypotheses": {
    "H1a": {
      "verdict": "supported",
      "why": "AVI is not the constraint (filler is, all 4 methods) and a second AVI gives +0.2% (95% CI -0.1 to +0.6%), not significant."
    },
    "H1b": {
      "verdict": "mixed",
      "why": "Queue wait before AVI falls 2.2 min; the queue before manual re-inspection rises 4 s (negligible, but opposite in direction)."
    },
    "H2a": {
      "verdict": "supported",
      "why": "Larger batches +5.9%, smaller -16.9%; baseline changeover share 27% of PPT, well above the 5% floor."
    },
    "H2b": {
      "verdict": "refuted as stated: not monotonic",
      "why": "Lead time rises at both levels. Merging batches adds cycle time (+8.7 h); halving batches cuts cycle time (-7.6 h) but QA release queueing grows +34.5 h, so QA release becomes the lead-time constraint."
    },
    "H3a": {
      "verdict": "refuted as registered",
      "why": "Wait-for-staff at the filler is 0.22% of PPT, yet +1 operator gives +3.5%. The waits sit downstream: cartoner 12.6% of its PPT (6.1% with +1 operator). The pre-registered test measured staff waits at the wrong station."
    },
    "H3b": {
      "verdict": "not testable",
      "why": "-1 mechanic means zero mechanics (A4)."
    },
    "H4a": {
      "verdict": "monotonic: supported; less than proportional: refuted, mechanism found",
      "why": "Filler run time is unchanged; its scheduled time falls 866 min at -50%, 1.45x its own changeover saving (596 min), because shorter downstream changeovers also cut the filler's blocked time (247 min). The minute accounting reconciles, so this is not an accounting error."
    },
    "H4b": {
      "verdict": "not examined",
      "why": "No small-batch x SMED scenario was registered."
    },
    "H5": {
      "verdict": "supported (exploratory)",
      "why": "AVI is not the constraint and the combination adds only +0.7% over changeover -50% alone (below the 3% practical threshold)."
    }
  },
  "errata": {
